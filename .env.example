PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/marketpivot
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:5173

# API Keys for external data providers
ALPHA_VANTAGE_KEY=your_key_here
RAPID_API_KEY=your_key_here
COINGECKO_API_KEY=your_key_here
NEWS_API_KEY=your_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpivot
DB_USER=postgres
DB_PASSWORD=password

# Cache
REDIS_URL=redis://localhost:6379

# Data refresh intervals (in minutes)
STOCK_DATA_REFRESH_INTERVAL=1
CRYPTO_DATA_REFRESH_INTERVAL=1
CURRENCY_DATA_REFRESH_INTERVAL=5
