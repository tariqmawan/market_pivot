PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=

# One-time dev bootstrap: signup with matching adminSetupSecret creates admin (never expose in prod UI)
ADMIN_SETUP_SECRET=

# Seeded admin (npm run db:seed)
SEED_ADMIN_EMAIL=admin@marketspivot.com
SEED_ADMIN_PASSWORD=AdminSetup123!
SEED_ADMIN_ROLE=admin
CORS_ORIGIN=http://localhost:5173

# API Keys for external data providers
ALPHA_VANTAGE_KEY=
RAPID_API_KEY=
COINGECKO_API_KEY=
NEWS_API_KEY=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpivot
DB_USER=postgres
DB_PASSWORD=

# Cache
REDIS_URL=redis://localhost:6379

# Data refresh intervals (in minutes)
STOCK_DATA_REFRESH_INTERVAL=1
CRYPTO_DATA_REFRESH_INTERVAL=1
CURRENCY_DATA_REFRESH_INTERVAL=5
